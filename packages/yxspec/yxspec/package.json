{
  "name": "@deepseek-ai/dsh-yxspec",
  "description": "YXSpec capability seam: ctx.yxspec service owning the ASPICE stage model, dual-track (MCU/MPU) map, and spec identity for gated automotive R&D flows",
  "version": "0.2.2-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/yxspec/yxspec"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./project": {
      "types": "./lib/types/project.d.ts",
      "default": "./lib/types/project.js"
    },
    "./tool-output": {
      "types": "./lib/types/tool-output.d.ts",
      "default": "./lib/types/tool-output.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
